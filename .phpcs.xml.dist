<?xml version="1.0"?>
<ruleset name="RAN Booster WP Pusher Migrator">
	<description>WordPress coding standards for the migration bridge.</description>

	<config name="minimum_wp_version" value="7.0"/>
	<config name="testVersion" value="8.2-"/>

	<!-- Scan every PHP file so views and future shipped entry points cannot escape the gate. -->
	<file>.</file>
	<exclude-pattern>/vendor/</exclude-pattern>
	<exclude-pattern>/node_modules/</exclude-pattern>
	<exclude-pattern>/.git/</exclude-pattern>
	<exclude-pattern>/.phpunit.cache/</exclude-pattern>
	<exclude-pattern>/.phpcs-cache</exclude-pattern>

	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="4"/>
	<arg value="sp"/>

	<rule ref="RANWordPressPlugin"/>

	<!-- #42: enforce the complete owned runtime cohort; test doubles and CLI
	     helpers retain separately audited foreign/deferred signatures. -->
	<rule ref="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid">
		<exclude-pattern>/tests/</exclude-pattern>
		<exclude-pattern>/scripts/</exclude-pattern>
	</rule>
	<rule ref="WordPress.NamingConventions.ValidVariableName">
		<exclude-pattern>/tests/</exclude-pattern>
		<exclude-pattern>/scripts/</exclude-pattern>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<!-- Included templates receive request-local variables from Plugin; they do not define public globals. -->
		<exclude-pattern>/views/</exclude-pattern>
		<exclude-pattern>/tests/</exclude-pattern>
		<properties>
			<property name="prefixes" type="array">
				<element value="ran_booster_wp_pusher_migrator"/>
				<element value="RAN\BoosterWpPusherMigrator"/>
			</property>
		</properties>
	</rule>

	<rule ref="Universal.NamingConventions.NoReservedKeywordParameterNames">
		<severity>0</severity>
	</rule>

	<!-- PHPUnit fixtures intentionally colocate small test doubles with their tests. -->
	<rule ref="Generic.Files.OneObjectStructurePerFile">
		<exclude-pattern>/tests/</exclude-pattern>
	</rule>
</ruleset>
