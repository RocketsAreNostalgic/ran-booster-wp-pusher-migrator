{
  "name": "rockets-are-nostalgic/ran-booster-wp-pusher-migrator",
  "description": "One-time WP Pusher 3.0.13 migration bridge for RAN Booster.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "support": {
    "docs": "https://github.com/RocketsAreNostalgic/ran-booster-wp-pusher-migrator#readme",
    "issues": "https://github.com/RocketsAreNostalgic/ran-booster-wp-pusher-migrator/issues",
    "source": "https://github.com/RocketsAreNostalgic/ran-booster-wp-pusher-migrator"
  },
  "extra": {
    "ran-booster-core-certification": {
      "tag": "v1.0.0-beta.15",
      "commit": "24f48726d05312319f4f78c4661281087de5463a"
    },
    "ran-booster-extension": {
      "schema": 1,
      "id": "ran-booster-wp-pusher-migrator",
      "name": "RAN Booster WP Pusher Migrator",
      "plugin-basename": "ran-booster-wp-pusher-migrator/ran-booster-wp-pusher-migrator.php",
      "repository": "https://github.com/RocketsAreNostalgic/ran-booster-wp-pusher-migrator",
      "update-uri": "https://github.com/RocketsAreNostalgic/ran-booster-wp-pusher-migrator",
      "availability": "free",
      "requires-wordpress": "7.0",
      "requires-php": "8.2",
      "booster-apis": {
        "required": {
          "portability": 2,
          "admin-interaction": 2
        },
        "optional": {}
      },
      "maturity": "beta",
      "documentation-uri": "https://github.com/RocketsAreNostalgic/ran-booster-wp-pusher-migrator#readme",
      "support-uri": "https://github.com/RocketsAreNostalgic/ran-booster-wp-pusher-migrator/issues",
      "security-uri": "https://github.com/RocketsAreNostalgic/ran-booster-wp-pusher-migrator/security/policy",
      "readiness": "public-release-required"
    }
  },
  "require": {
    "php": "^8.2"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.2.1",
    "phpunit/phpunit": "^11.0",
    "squizlabs/php_codesniffer": "^3.13.5",
    "wp-coding-standards/wpcs": "^3.4.1"
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "archive:build": "bash scripts/build-release.sh",
    "archive:build:head": "bash scripts/build-release.sh \"$(git rev-parse HEAD)\"",
    "archive:verify": "bash scripts/verify-release.sh",
    "lint:php": "find . -path ./vendor -prune -o -path ./node_modules -prune -o -path ./.git -prune -o -name '*.php' -exec php -l {} \\;",
    "standards": "phpcs --standard=.phpcs.xml.dist --report=summary",
    "test": "phpunit --configuration phpunit.xml",
    "test:release-candidate-contract": "bash tests/release-candidate-contract.sh",
    "check": [
      "@lint:php",
      "@standards",
      "@test",
      "@test:release-candidate-contract",
      "@archive:build:head"
    ]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
