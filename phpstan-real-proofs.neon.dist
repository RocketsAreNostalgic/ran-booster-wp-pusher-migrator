# Separate actual CLI/Core declarations from PHPUnit-owned Core doubles.
includes:
	- vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
	level: 8
	phpVersion: 80200
	scanFiles:
		- tests/source-candidate-bootstrap.php
		- tests/WpPusherSourceTest.php
	scanDirectories:
		- tests/fixtures/analysis
		- src
		- vendor/ran-source-core/source/RAN
	bootstrapFiles:
		- tests/phpstan-bootstrap.php
	tmpDir: vendor/ran-phpstan-real-proofs-cache
	# Runtime guards must also reject an incompatible loaded Core generation.
	dynamicConstantNames:
		- RAN\AddOn\Portability\PortabilityFacade::API_VERSION
		- RAN\Admin\Interaction\AdminInteractionFacade::API_VERSION
	paths:
		- tests/installed-candidate
		- tests/source-candidate-behaviour.php
	excludePaths:
		analyseAndScan:
			- tests/fixtures/PortabilityApi.php
			- tests/fixtures/AdminInteractionApi.php
			- tests/bootstrap.php
